{
  "version": 2,
  "builds": [
    {
      "src": "bfash-main/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": ".vercel/output/static" }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/(.*\\.(js|css|png|jpg|jpeg|svg|ico|json|txt))$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
